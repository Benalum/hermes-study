HERMES_STUDY_DATA_DIR=./data
HERMES_STUDY_HOST=127.0.0.1
HERMES_STUDY_PORT=8787

# Hermes Agent API. install_mac.sh fills the key from ~/.hermes/.env.
HERMES_AGENT_BASE_URL=http://127.0.0.1:8642/v1
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=hermes-agent
HERMES_AGENT_SESSION_KEY=hermes-study

HERMES_STUDY_TOP_K=6
HERMES_STUDY_SPEAKER_GATE=false
HERMES_STUDY_SPEAKER_THRESHOLD=0.72
HERMES_STUDY_WHISPER_MODEL=base.en
HERMES_STUDY_TAILSCALE_SERVE=1
